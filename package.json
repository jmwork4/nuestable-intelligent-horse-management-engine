{
  "name": "nuestable",
  "version": "2.0.0",
  "private": true,
  "description": "Nuestable — Horse Intelligent Management Engine",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:migrate": "pnpm --filter @nuestable/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @nuestable/api exec prisma db seed",
    "db:studio": "pnpm --filter @nuestable/api exec prisma studio",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.0.0"
  }
}
