{
  "name": "@nuestable/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared UI components for Nuestable",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
