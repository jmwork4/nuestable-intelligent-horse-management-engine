// ─────────────────────────────────────────────────────────────────────────────
// Nuestable — Horse Intelligent Management Engine
// Prisma Schema  ·  Phase 1 MVP
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════════════

enum UserRole {
  OWNER
  TRAINER
  BARN_MANAGER
  GROOM
  VET
  ADMIN
  SUPER_ADMIN
}

enum HorseSex {
  COLT
  FILLY
  GELDING
  MARE
  STALLION
  RIDGLING
}

enum HorseStatus {
  ACTIVE
  INJURED
  RETIRED
  SOLD
  DECEASED
  LAYUP
  BROODMARE
}

enum TransactionType {
  PURCHASE
  SALE
  CLAIM
}

enum MediaType {
  PHOTO
  VIDEO
  DOCUMENT
  XRAY
}

enum RaceType {
  MAIDEN
  CLAIMING
  ALLOWANCE
  STAKES
  GRADED_STAKES
  HANDICAP
  MAIDEN_CLAIMING
  STARTER_ALLOWANCE
  OPTIONAL_CLAIMING
  FUTURITY
  DERBY
  OTHER
}

enum RaceSurface {
  DIRT
  TURF
  SYNTHETIC
  ALL_WEATHER
}

enum RaceStatus {
  SCHEDULED
  ENTRIES_OPEN
  ENTRIES_CLOSED
  SCRATCHES_FINAL
  IN_PROGRESS
  OFFICIAL
  CANCELLED
  POSTPONED
}

enum EntryStatus {
  ENTERED
  CONFIRMED
  SCRATCHED
  FINISHED
  DQ
}

enum DocumentCategory {
  REGISTRATION
  COGGINS
  HEALTH_CERTIFICATE
  INSURANCE
  BILL_OF_SALE
  CONTRACT
  VET_RECORD
  FARRIER_RECORD
  JOCKEY_CLUB
  RACING_LICENSE
  OTHER
}

enum DocumentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum StallStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum ChecklistStatus {
  IN_PROGRESS
  COMPLETED
}

enum FeedMeal {
  AM
  MIDDAY
  PM
  SUPPLEMENT
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum HealthRecordType {
  EXAM
  DENTAL
  FARRIER
  SURGERY
  IMAGING
  SCOPE
  BLOODWORK
  DEWORMING
  CHIROPRACTIC
  ACUPUNCTURE
  OTHER
}

enum InjurySeverity {
  MINOR
  MODERATE
  SEVERE
  CRITICAL
}

enum InjuryStatus {
  ACTIVE
  HEALING
  RESOLVED
  CHRONIC
}

enum ExpenseCategory {
  TRAINING
  VETERINARY
  FARRIER
  FEED
  BOARDING
  TRANSPORT
  INSURANCE
  REGISTRATION
  JOCKEY_FEE
  EQUIPMENT
  MEDICATION
  THERAPY
  ADMIN
  OTHER
}

enum RevenueCategory {
  PURSE_EARNINGS
  CLAIMING_SALE
  PRIVATE_SALE
  BREEDING
  INSURANCE_CLAIM
  SPONSORSHIP
  OTHER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
  PARTIAL
}

enum PayoutType {
  PURSE_DISTRIBUTION
  SALE_PROCEEDS
  INSURANCE_PAYOUT
  BREEDING_FEE
  OTHER
}

enum NotificationType {
  RACE_ENTRY
  RACE_RESULT
  RACE_SCRATCH
  HEALTH_ALERT
  MEDICATION_DUE
  DOCUMENT_EXPIRING
  TASK_ASSIGNED
  TASK_DUE
  INVOICE_CREATED
  INVOICE_OVERDUE
  VOTE_OPENED
  VOTE_CLOSING
  MESSAGE_RECEIVED
  DAILY_REPORT
  GENERAL
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum VoteStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  BOUNCED
}

// ═══════════════════════════════════════════════════════════════════════════════
// AUTH & MULTI-TENANCY
// ═══════════════════════════════════════════════════════════════════════════════

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("starter")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users             User[]
  refreshTokens     RefreshToken[]
  horses            Horse[]
  horseOwnerships   HorseOwnership[]
  purchaseSales     PurchaseSale[]
  mediaItems        MediaItem[]
  races             Race[]
  raceEntries       RaceEntry[]
  tripNotes         TripNote[]
  documents         Document[]
  barns             Barn[]
  stalls            Stall[]
  dailyChecklists   DailyChecklist[]
  feedLogs          FeedLog[]
  therapyLogs       TherapyLog[]
  taskAssignments   TaskAssignment[]
  operationLogs     OperationLog[]
  healthRecords     HealthRecord[]
  medicationLogs    MedicationLog[]
  vaccinations      Vaccination[]
  injuries          Injury[]
  labResults        LabResult[]
  expenses          Expense[]
  revenues          Revenue[]
  invoices          Invoice[]
  payouts           Payout[]
  messages          Message[]
  messageThreads    MessageThread[]
  syndicateVotes    SyndicateVote[]
  notifications     Notification[]
  notificationPrefs NotificationPref[]
  alertDeliveryLogs AlertDeliveryLog[]

  @@map("organizations")
}

model User {
  id           String    @id @default(cuid())
  orgId        String
  email        String
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole
  phone        String?
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  org               Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  refreshTokens     RefreshToken[]
  horseOwnerships   HorseOwnership[]
  tripNotes         TripNote[]
  documentsUploaded Document[]
  dailyChecklists   DailyChecklist[]   @relation("ChecklistCreator")
  checklistItems    DailyChecklistItem[] @relation("ChecklistItemCompleter")
  feedLogs          FeedLog[]
  therapyLogs       TherapyLog[]
  taskAssignments   TaskAssignment[]
  operationLogs     OperationLog[]
  medicationLogs    MedicationLog[]
  sentMessages      Message[]          @relation("MessageSender")
  receivedMessages  Message[]          @relation("MessageRecipient")
  syndicateVotes    SyndicateVote[]
  voteEntries       SyndicateVoteEntry[]
  notifications     Notification[]
  notificationPrefs NotificationPref[]

  @@unique([orgId, email])
  @@index([orgId])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  orgId     String
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  // Relations
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orgId])
  @@index([token])
  @@map("refresh_tokens")
}

// ═══════════════════════════════════════════════════════════════════════════════
// HORSE PROFILES (MOD-006)
// ═══════════════════════════════════════════════════════════════════════════════

model Horse {
  id              String      @id @default(cuid())
  orgId           String
  name            String
  registeredName  String?
  foalDate        DateTime?
  sex             HorseSex
  color           String?
  sireId          String?
  damId           String?
  sireName        String?
  damName         String?
  tattooNumber    String?
  chipNumber      String?
  registrationNum String?
  status          HorseStatus @default(ACTIVE)
  currentBarnId   String?
  currentStallId  String?
  profileImageUrl String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Self-referencing relations
  sire     Horse?  @relation("HorseSire", fields: [sireId], references: [id], onDelete: SetNull)
  dam      Horse?  @relation("HorseDam", fields: [damId], references: [id], onDelete: SetNull)
  sireOf   Horse[] @relation("HorseSire")
  damOf    Horse[] @relation("HorseDam")

  // Location relations
  currentBarn  Barn?  @relation(fields: [currentBarnId], references: [id], onDelete: SetNull)
  currentStall Stall? @relation(fields: [currentStallId], references: [id], onDelete: SetNull)

  // Other relations
  org              Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  ownerships       HorseOwnership[]
  purchaseSales    PurchaseSale[]
  mediaItems       MediaItem[]
  raceEntries      RaceEntry[]
  tripNotes        TripNote[]
  documents        Document[]
  feedLogs         FeedLog[]
  therapyLogs      TherapyLog[]
  taskAssignments  TaskAssignment[]
  operationLogs    OperationLog[]
  healthRecords    HealthRecord[]
  medicationLogs   MedicationLog[]
  vaccinations     Vaccination[]
  injuries         Injury[]
  labResults       LabResult[]
  expenses         Expense[]
  revenues         Revenue[]
  payouts          Payout[]
  messages         Message[]
  messageThreads   MessageThread[]
  syndicateVotes   SyndicateVote[]
  checklistItems   DailyChecklistItem[]

  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, name])
  @@index([registrationNum])
  @@index([chipNumber])
  @@index([currentBarnId])
  @@index([currentStallId])
  @@map("horses")
}

model HorseOwnership {
  id           String    @id @default(cuid())
  orgId        String
  horseId      String
  userId       String?
  ownerName    String
  ownershipPct Decimal   @db.Decimal(5, 2)
  startDate    DateTime
  endDate      DateTime?
  createdAt    DateTime  @default(now())

  // Relations
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  horse Horse        @relation(fields: [horseId], references: [id], onDelete: Cascade)
  user  User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([horseId])
  @@index([userId])
  @@map("horse_ownerships")
}

model PurchaseSale {
  id      String          @id @default(cuid())
  orgId   String
  horseId String
  type    TransactionType
  amount  Decimal         @db.Decimal(12, 2)
  date    DateTime
  buyer   String?
  seller  String?
  notes   String?
  createdAt DateTime      @default(now())

  // Relations
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  horse Horse        @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([horseId])
  @@map("purchase_sales")
}

model MediaItem {
  id        String    @id @default(cuid())
  orgId     String
  horseId   String
  type      MediaType
  url       String
  caption   String?
  takenAt   DateTime?
  createdAt DateTime  @default(now())

  // Relations
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  horse Horse        @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([horseId])
  @@map("media_items")
}

// ═══════════════════════════════════════════════════════════════════════════════
// RACE INTELLIGENCE (MOD-001)
// ═══════════════════════════════════════════════════════════════════════════════

model Race {
  id                String       @id @default(cuid())
  orgId             String
  externalRaceId    String?
  trackName         String
  trackCode         String?
  raceDate          DateTime
  postTime          DateTime?
  raceNumber        Int?
  raceName          String?
  raceType          RaceType
  surface           RaceSurface?
  distance          String?
  distanceFurlongs  Decimal?     @db.Decimal(5, 2)
  purse             Decimal?     @db.Decimal(12, 2)
  claimingPrice     Decimal?     @db.Decimal(12, 2)
  conditions        String?      @db.Text
  raceClass         String?
  status            RaceStatus
  isStakes          Boolean      @default(false)
  stakesGrade       String?
  entryDeadline     DateTime?
  scratchDeadline   DateTime?
  resultsJson       Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  entries RaceEntry[]

  @@index([orgId])
  @@index([orgId, raceDate])
  @@index([orgId, trackName])
  @@index([orgId, status])
  @@index([externalRaceId])
  @@map("races")
}

model RaceEntry {
  id              String       @id @default(cuid())
  orgId           String
  raceId          String
  horseId         String
  postPosition    Int?
  morningLineOdds String?
  jockeyName      String?
  weight          String?
  medication      String?
  equipment       String?
  finishPosition  Int?
  officialTime    String?
  margin          String?
  speedFigure     Int?
  purseEarned     Decimal?     @db.Decimal(12, 2)
  status          EntryStatus
  scratchReason   String?
  classMovement   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  race  Race         @relation(fields: [raceId], references: [id], onDelete: Cascade)
  horse Horse        @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@unique([raceId, horseId])
  @@index([orgId])
  @@index([horseId])
  @@index([raceId])
  @@index([orgId, horseId])
  @@map("race_entries")
}

model TripNote {
  id        String   @id @default(cuid())
  orgId     String
  horseId   String
  raceDate  DateTime
  trackName String
  note      String   @db.Text
  tags      String[]
  authorId  String
  createdAt DateTime @default(now())

  // Relations
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  horse  Horse        @relation(fields: [horseId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([horseId])
  @@index([orgId, horseId])
  @@map("trip_notes")
}

// ═══════════════════════════════════════════════════════════════════════════════
// DOCUMENTS (MOD-002)
// ═══════════════════════════════════════════════════════════════════════════════

model Document {
  id              String           @id @default(cuid())
  orgId           String
  horseId         String?
  title           String
  category        DocumentCategory
  fileUrl         String
  fileSize        Int
  mimeType        String
  expiresAt       DateTime?
  aiExtractedData Json?
  aiConfidence    Decimal?         @db.Decimal(3, 2)
  status          DocumentStatus   @default(PENDING)
  uploadedById    String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  horse      Horse?       @relation(fields: [horseId], references: [id], onDelete: SetNull)
  uploadedBy User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([horseId])
  @@index([orgId, category])
  @@index([orgId, expiresAt])
  @@map("documents")
}

// ═══════════════════════════════════════════════════════════════════════════════
// OPERATIONS (MOD-003)
// ═══════════════════════════════════════════════════════════════════════════════

model Barn {
  id        String  @id @default(cuid())
  orgId     String
  name      String
  location  String?
  capacity  Int?
  createdAt DateTime @default(now())

  // Relations
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stalls Stall[]
  horses Horse[]

  @@index([orgId])
  @@map("barns")
}

model Stall {
  id     String      @id @default(cuid())
  orgId  String
  barnId String
  number String
  status StallStatus @default(AVAILABLE)

  // Relations
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  barn   Barn         @relation(fields: [barnId], references: [id], onDelete: Cascade)
  horses Horse[]

  @@unique([barnId, number])
  @@index([orgId])
  @@index([barnId])
  @@map("stalls")
}

model DailyChecklist {
  id          String          @id @default(cuid())
  orgId       String
  date        DateTime        @db.Date
  createdById String
  status      ChecklistStatus @default(IN_PROGRESS)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  org       Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy User                 @relation("ChecklistCreator", fields: [createdById], references: [id], onDelete: Cascade)
  items     DailyChecklistItem[]

  @@unique([orgId, date])
  @@index([orgId])
  @@index([orgId, date])
  @@map("daily_checklists")
}

model DailyChecklistItem {
  id            String    @id @default(cuid())
  checklistId   String
  horseId       String?
  description   String
  isCompleted   Boolean   @default(false)
  completedById String?
  completedAt   DateTime?
  sortOrder     Int       @default(0)

  // Relations
  checklist   DailyChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  horse       Horse?         @relation(fields: [horseId], references: [id], onDelete: SetNull)
  completedBy User?          @relation("ChecklistItemCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([checklistId])
  @@index([horseId])
  @@map("daily_checklist_items")
}

model FeedLog {
  id          String   @id @default(cuid())
  orgId       String
  horseId     String
  date        DateTime @db.Date
  meal        FeedMeal
  feedType    String
  quantity    String
  unit        String
  supplements String?
  notes       String?
  loggedById  String
  createdAt   DateTime @default(now())

  // Relations
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  horse    Horse        @relation(fields: [horseId], references: [id], onDelete: Cascade)
  loggedBy User         @relation(fields: [loggedById], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([horseId])
  @@index([orgId, horseId, date])
  @@map("feed_logs")
}

model TherapyLog {
  id          String   @id @default(cuid())
  orgId       String
  horseId     String
  date        DateTime
  therapyType String
  duration    Int?
  provider    String?
  notes       String?
  loggedById  String
  createdAt   DateTime @default(now())

  // Relations
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  horse    Horse        @relation(fields: [horseId], references: [id], onDelete: Cascade)
  loggedBy User         @relation(fields: [loggedById], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([horseId])
  @@index([orgId, horseId])
  @@map("therapy_logs")
}

model TaskAssignment {
  id          String     @id @default(cuid())
  orgId       String
  title       String
  description String?
  assigneeId  String
  horseId     String?
  dueDate     DateTime?
  priority    TaskPriority @default(NORMAL)
  status      TaskStatus   @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignee User         @relation(fields: [assigneeId], references: [id], onDelete: Cascade)
  horse    Horse?       @relation(fields: [horseId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([assigneeId])
  @@index([horseId])
  @@index([orgId, status])
  @@index([orgId, assigneeId, status])
  @@map("task_assignments")
}

model OperationLog {
  id        String   @id @default(cuid())
  orgId     String
  authorId  String
  horseId   String?
  category  String
  content   String   @db.Text
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  horse  Horse?       @relation(fields: [horseId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([horseId])
  @@index([orgId, category])
  @@index([orgId, createdAt])
  @@map("operation_logs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// HEALTH (MOD-005)
// ═══════════════════════════════════════════════════════════════════════════════

model HealthRecord {
  id             String           @id @default(cuid())
  orgId          String
  horseId        String
  date           DateTime
  type           HealthRecordType
  description    String           @db.Text
  vetName        String?
  findings       String?          @db.Text
  treatment      String?          @db.Text
  followUpDate   DateTime?
  attachmentUrls String[]
  createdAt      DateTime         @default(now())

  // Relations
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  horse Horse        @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([horseId])
  @@index([orgId, horseId, date])
  @@index([orgId, type])
  @@map("health_records")
}

model MedicationLog {
  id               String    @id @default(cuid())
  orgId            String
  horseId          String
  medicationName   String
  dosage           String
  route            String
  administeredAt   DateTime
  administeredById String
  withdrawalHours  Int?
  withdrawalEndsAt DateTime?
  isControlled     Boolean   @default(false)
  notes            String?
  createdAt        DateTime  @default(now())

  // Relations
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  horse          Horse        @relation(fields: [horseId], references: [id], onDelete: Cascade)
  administeredBy User         @relation(fields: [administeredById], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([horseId])
  @@index([orgId, horseId])
  @@index([orgId, withdrawalEndsAt])
  @@index([orgId, isControlled])
  @@map("medication_logs")
}

model Vaccination {
  id          String    @id @default(cuid())
  orgId       String
  horseId     String
  vaccine     String
  batchNumber String?
  givenDate   DateTime
  expiresAt   DateTime?
  vetName     String?
  notes       String?
  createdAt   DateTime  @default(now())

  // Relations
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  horse Horse        @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([horseId])
  @@index([orgId, expiresAt])
  @@map("vaccinations")
}

model Injury {
  id            String         @id @default(cuid())
  orgId         String
  horseId       String
  description   String
  location      String
  severity      InjurySeverity
  dateOccurred  DateTime
  dateResolved  DateTime?
  status        InjuryStatus   @default(ACTIVE)
  treatmentPlan String?        @db.Text
  notes         String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  horse Horse        @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([horseId])
  @@index([orgId, status])
  @@index([orgId, horseId, status])
  @@map("injuries")
}

model LabResult {
  id            String    @id @default(cuid())
  orgId         String
  horseId       String
  testType      String
  testDate      DateTime
  resultDate    DateTime?
  lab           String?
  results       Json
  isNormal      Boolean?
  notes         String?
  attachmentUrl String?
  createdAt     DateTime  @default(now())

  // Relations
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  horse Horse        @relation(fields: [horseId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([horseId])
  @@index([orgId, horseId])
  @@map("lab_results")
}

// ═══════════════════════════════════════════════════════════════════════════════
// FINANCIAL (MOD-007)
// ═══════════════════════════════════════════════════════════════════════════════

model Expense {
  id          String          @id @default(cuid())
  orgId       String
  horseId     String?
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime
  vendorName  String?
  invoiceId   String?
  isRecurring Boolean         @default(false)
  createdAt   DateTime        @default(now())

  // Relations
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  horse Horse?       @relation(fields: [horseId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([horseId])
  @@index([orgId, category])
  @@index([orgId, date])
  @@index([orgId, horseId, date])
  @@map("expenses")
}

model Revenue {
  id          String          @id @default(cuid())
  orgId       String
  horseId     String?
  category    RevenueCategory
  description String
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime
  source      String?
  createdAt   DateTime        @default(now())

  // Relations
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  horse Horse?       @relation(fields: [horseId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([horseId])
  @@index([orgId, category])
  @@index([orgId, date])
  @@map("revenues")
}

model Invoice {
  id          String        @id @default(cuid())
  orgId       String
  invoiceNum  String
  ownerId     String?
  ownerName   String
  status      InvoiceStatus @default(DRAFT)
  subtotal    Decimal       @db.Decimal(12, 2)
  tax         Decimal       @default(0) @db.Decimal(12, 2)
  total       Decimal       @db.Decimal(12, 2)
  dueDate     DateTime?
  paidAt      DateTime?
  periodStart DateTime?
  periodEnd   DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  payouts Payout[]

  @@unique([orgId, invoiceNum])
  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, dueDate])
  @@map("invoices")
}

model Payout {
  id        String    @id @default(cuid())
  orgId     String
  invoiceId String?
  ownerId   String?
  ownerName String
  horseId   String?
  amount    Decimal   @db.Decimal(12, 2)
  type      PayoutType
  date      DateTime
  notes     String?
  createdAt DateTime  @default(now())

  // Relations
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoice Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  horse   Horse?       @relation(fields: [horseId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([invoiceId])
  @@index([horseId])
  @@index([orgId, date])
  @@map("payouts")
}

// ═══════════════════════════════════════════════════════════════════════════════
// OWNER TRANSPARENCY (MOD-004)
// ═══════════════════════════════════════════════════════════════════════════════

model Message {
  id          String    @id @default(cuid())
  orgId       String
  threadId    String?
  senderId    String
  recipientId String?
  horseId     String?
  subject     String?
  body        String    @db.Text
  isRead      Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  // Relations
  org       Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  thread    MessageThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)
  sender    User           @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User?          @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  horse     Horse?         @relation(fields: [horseId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([threadId])
  @@index([senderId])
  @@index([recipientId])
  @@index([horseId])
  @@index([orgId, recipientId, isRead])
  @@map("messages")
}

model MessageThread {
  id        String   @id @default(cuid())
  orgId     String
  horseId   String?
  subject   String
  createdAt DateTime @default(now())

  // Relations
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  horse    Horse?       @relation(fields: [horseId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([orgId])
  @@index([horseId])
  @@map("message_threads")
}

model SyndicateVote {
  id            String     @id @default(cuid())
  orgId         String
  horseId       String
  proposalTitle String
  proposalBody  String     @db.Text
  createdById   String
  deadline      DateTime
  status        VoteStatus @default(OPEN)
  createdAt     DateTime   @default(now())

  // Relations
  org       Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  horse     Horse                @relation(fields: [horseId], references: [id], onDelete: Cascade)
  createdBy User                 @relation(fields: [createdById], references: [id], onDelete: Cascade)
  entries   SyndicateVoteEntry[]

  @@index([orgId])
  @@index([horseId])
  @@index([orgId, status])
  @@map("syndicate_votes")
}

model SyndicateVoteEntry {
  id      String   @id @default(cuid())
  voteId  String
  userId  String
  choice  String
  votedAt DateTime @default(now())

  // Relations
  vote SyndicateVote @relation(fields: [voteId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([voteId, userId])
  @@index([voteId])
  @@index([userId])
  @@map("syndicate_vote_entries")
}

// ═══════════════════════════════════════════════════════════════════════════════
// NOTIFICATIONS (MOD-009)
// ═══════════════════════════════════════════════════════════════════════════════

model Notification {
  id          String              @id @default(cuid())
  orgId       String
  userId      String
  type        NotificationType
  title       String
  body        String
  data        Json?
  channel     NotificationChannel
  isRead      Boolean             @default(false)
  readAt      DateTime?
  deliveredAt DateTime?
  createdAt   DateTime            @default(now())

  // Relations
  org              Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertDeliveryLogs AlertDeliveryLog[]

  @@index([orgId])
  @@index([userId])
  @@index([orgId, userId, isRead])
  @@index([orgId, type])
  @@map("notifications")
}

model NotificationPref {
  id      String              @id @default(cuid())
  orgId   String
  userId  String
  type    NotificationType
  channel NotificationChannel
  enabled Boolean             @default(true)

  // Relations
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, channel])
  @@index([orgId])
  @@index([userId])
  @@map("notification_prefs")
}

model AlertDeliveryLog {
  id             String         @id @default(cuid())
  orgId          String
  notificationId String
  channel        NotificationChannel
  status         DeliveryStatus
  error          String?
  attemptedAt    DateTime
  deliveredAt    DateTime?

  // Relations
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([notificationId])
  @@index([orgId, status])
  @@map("alert_delivery_logs")
}
