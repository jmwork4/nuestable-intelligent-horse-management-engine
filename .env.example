# ===========================================
# Nuestable — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ---- Database ----
DATABASE_URL="postgresql://nuestable:nuestable@localhost:5432/nuestable?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- JWT (min 32 chars each) ----
JWT_SECRET="change-me-in-production-must-be-32-chars-long"
JWT_REFRESH_SECRET="change-me-in-production-refresh-must-be-32chars"

# ---- Anthropic (document AI extraction) ----
ANTHROPIC_API_KEY=""

# ---- Stripe (payments — optional) ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- The Racing API (optional) ----
RACING_API_KEY=""
RACING_API_BASE_URL="https://api.theracingapi.com/v1"

# ---- File Storage ----
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"

# ---- App ----
NODE_ENV="development"
PORT=3000
CORS_ORIGIN="http://localhost:5173"
LOG_LEVEL="info"
